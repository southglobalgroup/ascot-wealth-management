---
/* SHARE YOUR EXPERIENCE (/submit-testimonial; "Share Your Experience" on /testimonials links here). The live form's fields and words;
   the rating is five stars to choose from (five by default, as there). Like the contact form it never pretends to send: while
   site.formEndpoint is empty, Submit shows the same notice (telephone, email) and keeps everything typed. */
import Layout from '../layouts/Layout.astro'
import PageHero from '../components/PageHero.astro'
import { submitTestimonial as t } from '../data/pages/submit-testimonial'
import { site } from '../data/site'
const f = t.form.fields
---

<Layout title={t.meta.title} description={t.meta.description} path="/submit-testimonial">
  <PageHero crumbs={[{ label: 'Client Testimonials', href: '/testimonials' }, { label: t.title }]} eyebrow="Client Testimonials" title={t.title} lede={t.lede} />

  <section class="section st" aria-labelledby="st-title">
    <div class="wrap st__in">
      <div class="st__card">
        <h2 id="st-title" class="st__title">{t.form.title}</h2>
        <p>{t.form.text}</p>

        <form class="st__form" method="post" data-testimonial data-endpoint={site.formEndpoint} aria-labelledby="st-title">
          <div class="st__trap" aria-hidden="true">
            <label for="st-website">Website</label>
            <input id="st-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="st__grid">
            <div class="st__field">
              <label for="st-name">{f.name}</label>
              <input id="st-name" name="name" type="text" autocomplete="name" maxlength="100" required />
            </div>
            <div class="st__field">
              <label for="st-email">{f.email}</label>
              <input id="st-email" name="email" type="email" autocomplete="email" maxlength="255" required />
            </div>
            <div class="st__field">
              <label for="st-phone">{f.phone}</label>
              <input id="st-phone" name="phone" type="tel" autocomplete="tel" maxlength="50" required />
            </div>
            <div class="st__field">
              <label for="st-role">{f.role}</label>
              <input id="st-role" name="role" type="text" autocomplete="organization-title" maxlength="100" />
            </div>
            <div class="st__field st__wide">
              <label for="st-company">{f.company}</label>
              <input id="st-company" name="company" type="text" autocomplete="organization" maxlength="100" />
            </div>
            <div class="st__field st__wide">
              <label for="st-text">{f.testimonial}</label>
              <textarea id="st-text" name="testimonial" rows="7" maxlength="2000" required aria-describedby="st-hint"></textarea>
              <p class="small" id="st-hint">{f.testimonialHint}</p>
            </div>
            <fieldset class="st__field st__wide st__rating">
              <legend>{f.rating}</legend>
              <div class="st__stars">
                {
                  [5, 4, 3, 2, 1].map((n) => (
                    <>
                      <input type="radio" name="rating" id={`st-r${n}`} value={n} checked={n === 5} />
                      <label for={`st-r${n}`} title={`${n} star${n > 1 ? 's' : ''}`}>
                        <svg viewBox="0 0 20 20" width="22" height="22" aria-hidden="true"><path d="m10 1.8 2.5 5.3 5.8.7-4.3 4 1.1 5.7L10 14.7l-5.1 2.8L6 11.8 1.7 7.8l5.8-.7L10 1.8Z" /></svg>
                        <span class="sr-only">{n} star{n > 1 ? 's' : ''}</span>
                      </label>
                    </>
                  ))
                }
              </div>
              <p class="st__chosen small" aria-live="polite" data-chosen>5 stars</p>
            </fieldset>
          </div>

          <button type="submit" class="btn btn-gold st__send">{t.form.submit}</button>
          <p class="st__notice" role="status" tabindex="-1" data-notice data-off>
            We couldn't send this form. Please call us on <a class="num" href={site.phoneHref}>{site.phoneDisplay}</a> or email
            <a href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
        </form>
      </div>

      <aside class="st__before" aria-labelledby="st-before">
        <h2 id="st-before" class="h3">{t.before.title}</h2>
        <ul role="list">
          {t.before.items.map((i) => <li>{i}</li>)}
        </ul>
      </aside>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-testimonial]').forEach((form) => {
    const notice = form.querySelector<HTMLElement>('[data-notice]')!
    const chosen = form.querySelector<HTMLElement>('[data-chosen]')!
    form.querySelectorAll<HTMLInputElement>('input[name="rating"]').forEach((r) =>
      r.addEventListener('change', () => (chosen.textContent = `${r.value} star${r.value === '1' ? '' : 's'}`)),
    )
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (!form.reportValidity()) return
      const data = Object.fromEntries(new FormData(form).entries())
      if (data.website) return // the spam trap was filled in
      const endpoint = form.dataset.endpoint
      if (endpoint) {
        try {
          const res = await fetch(endpoint, { method: 'POST', headers: { 'content-type': 'text/plain;charset=UTF-8' }, body: JSON.stringify(data) })
          if (res.ok) {
            form.innerHTML = `<p class="st__notice" role="status">${form.closest('.st__card')?.querySelector('p')?.textContent ?? ''}</p>`
            return
          }
        } catch {}
      }
      notice.removeAttribute('data-off')
      notice.focus()
    })
  })
</script>

<style>
  .st__in {
    display: grid;
    gap: 2.5rem 4rem;
    align-items: start;
  }
  @media (min-width: 64em) {
    .st__in {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    }
  }
  .st__card {
    display: grid;
    gap: 0.9rem;
    padding: clamp(1.5rem, 1rem + 2.5vw, 2.75rem);
    border-top: 2px solid var(--color-gold);
    border-radius: var(--radius);
    background: var(--color-mist);
  }
  .st__title {
    font-size: clamp(1.5rem, 1.25rem + 0.8vw, 1.9rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .st__form {
    display: grid;
    gap: 1.25rem;
    margin-top: 0.75rem;
  }
  .st__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .st__grid {
    display: grid;
    gap: 1.1rem 1rem;
  }
  @media (min-width: 40em) {
    .st__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .st__wide {
      grid-column: 1 / -1;
    }
  }
  .st__field {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
    border: 0;
    padding: 0;
    margin: 0;
  }
  .st__field label,
  .st__field legend {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .st__field input:not([type='radio']),
  .st__field textarea {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius);
    background: var(--color-paper);
    color: var(--color-ink);
    font: inherit;
    font-size: 1rem;
    transition: border-color 0.2s var(--ease-soft);
  }
  .st__field textarea {
    resize: vertical;
    min-height: 10rem;
  }
  .st__field input:hover,
  .st__field textarea:hover {
    border-color: var(--color-ink-3);
  }
  .st__field input:focus,
  .st__field textarea:focus {
    border-color: var(--color-navy);
  }
  /* five stars, chosen from the left (the inputs run 5..1 so that ~ can light every star before the chosen one) */
  .st__stars {
    display: inline-flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 0.25rem;
    margin-top: 0.4rem;
  }
  .st__stars input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .st__stars label {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius);
    background: var(--color-paper);
    cursor: pointer;
    color: var(--color-line-strong);
    transition:
      color 0.2s var(--ease-soft),
      border-color 0.2s var(--ease-soft);
  }
  .st__stars svg {
    fill: currentColor;
  }
  .st__stars input:checked ~ label,
  .st__stars label:hover,
  .st__stars label:hover ~ label {
    color: var(--color-gold);
    border-color: var(--color-gold);
  }
  .st__stars input:focus-visible + label {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .st__send {
    justify-self: start;
    min-width: 12rem;
  }
  .st__notice {
    padding: 0.9rem 1rem;
    border-left: 2px solid var(--color-gold);
    background: var(--color-paper);
    outline: none;
  }
  .st__notice[data-off] {
    display: none;
  }
  .st__before {
    display: grid;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line-strong);
  }
  .st__before ul {
    display: grid;
  }
  .st__before li {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink-2);
  }
</style>
