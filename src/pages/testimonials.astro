---
/* /testimonials, "Client Testimonials": their three figures under the title, the four rated advisers as portraits with their
   VouchedFor ratings, then the ten client reviews word for word with only the attribution the live page gives them. */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Layout from '../layouts/Layout.astro'
import PageHero from '../components/PageHero.astro'
import Closing from '../components/Closing.astro'
import vouched from '../assets/brand/vouchedfor-logo.svg'
import oak from '../assets/img/oak-table.webp'
import { testimonialsPage as t } from '../data/pages/testimonials'

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/img/staff/*.webp', { eager: true })
const photo = (id: string) => files[`../assets/img/staff/${id}.webp`]?.default
const star = 'm10 1.8 2.5 5.3 5.8.7-4.3 4 1.1 5.7L10 14.7l-5.1 2.8L6 11.8 1.7 7.8l5.8-.7L10 1.8Z'
const s = t.stories
---

<Layout title={t.title} description={t.description} path="/testimonials">
  <PageHero crumbs={[{ label: 'Client Testimonials' }]} eyebrow="Who We Are" title={t.hero.title} lede={t.hero.lede}>
    <dl class="tx__stats">
      {
        t.stats.map((x) => (
          <div>
            <dt class="tx__label">
              {x.label}
              {x.sub && <span class="small">{x.sub}</span>}
            </dt>
            <dd class="tx__value num">
              {x.value}
              {x.unit && <span class="tx__unit">{x.unit}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </PageHero>

  <section class="section ra" aria-labelledby="ra-title">
    <div class="wrap">
      <h2 id="ra-title" class="h2">{t.advisers.title}</h2>
      <ul class="ra__grid" role="list">
        {
          t.advisers.people.map((p) => {
            const img = photo(p.id)
            return (
              <li class="ra__card">
                <div class="ra__photo">{img && <Image src={img} alt={p.name} widths={[300, 450, 600]} sizes="(min-width: 64em) 270px, 45vw" class="fill-img" />}</div>
                <p class="ra__score num">
                  {p.rating}
                  <span class="ra__stars" aria-hidden="true">
                    {Array.from({ length: 5 }, () => (
                      <svg viewBox="0 0 20 20" width="12" height="12">
                        <path d={star} fill="currentColor" />
                      </svg>
                    ))}
                  </span>
                </p>
                <h3 class="ra__name">{p.name}</h3>
                <p class="ra__role">{p.role}</p>
                <p class="small num">{p.reviews}</p>
                <a class="link-arrow ra__link" href={`/staff#${p.id}`}>
                  {t.advisers.link}
                  <span class="sr">: {p.name}</span>
                  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                    <path d="M3 8h9.5M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                </a>
              </li>
            )
          })
        }
      </ul>
    </div>
  </section>

  <section class="section bg-tint rv" aria-labelledby="rv-title">
    <div class="wrap">
      <div class="head-split">
        <div class="head">
          <h2 id="rv-title" class="h2">{s.title}</h2>
          <p class="lede">{s.text}</p>
        </div>
        <div class="rv__vf">
          <Image src={vouched} alt="VouchedFor" width={150} height={Math.round((150 * vouched.height) / vouched.width)} />
          <div>
            <h3 class="rv__vfh">{t.verified.title}</h3>
            <p class="small">{t.verified.text}</p>
          </div>
        </div>
      </div>

      <ul class="rv__grid" role="list">
        {
          t.reviews.map((r) => (
            <li class="rv__card">
              <figure>
                <div class="rv__meta">
                  <span class="rv__stars" role="img" aria-label={s.stars}>
                    {Array.from({ length: 5 }, () => (
                      <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
                        <path d={star} fill="currentColor" />
                      </svg>
                    ))}
                  </span>
                  <span class="rv__tag">{s.verified}</span>
                  {r.featured && <span class="rv__tag">{s.featured}</span>}
                </div>
                <blockquote class="rv__quote">
                  <p>“{r.text}”</p>
                </blockquote>
                <figcaption class="rv__who">
                  <span class="rv__name">{s.who}</span>
                  <span class="small">{r.place}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>

      <div class="rv__share">
        <p>{t.share.text}</p>
        <a class="btn btn-line" href={t.share.href}>{t.share.cta}</a>
      </div>
    </div>
  </section>

  <Closing title={t.closing.title} text={t.closing.text} actions={t.closing.actions} image={oak} alt="A warm oak table in a quiet room, ready for a planning conversation" />
</Layout>

<style>
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* the three figures under the title */
  .tx__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1rem;
    border-top: 1px solid var(--color-line);
  }
  .tx__stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.35rem;
    padding: 1.1rem 1rem 0 0;
  }
  .tx__stats div + div {
    padding-left: 1rem;
    border-left: 1px solid var(--color-line);
  }
  .tx__value {
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-navy);
  }
  .tx__unit {
    font-size: 0.5em;
    color: var(--color-ink-3);
  }
  .tx__label {
    display: grid;
    gap: 0.1rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-ink);
  }

  /* the rated advisers */
  .ra__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  @media (min-width: 64em) {
    .ra__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem;
    }
  }
  .ra__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }
  .ra__photo {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 6;
    overflow: hidden;
    margin-bottom: 1.1rem;
    background: var(--color-mist-2);
  }
  .ra__score {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.75rem;
    font-weight: 300;
    line-height: 1;
    color: var(--color-navy);
  }
  .ra__stars,
  .rv__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--color-gold);
  }
  .ra__name {
    margin-top: 0.8rem;
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .ra__role {
    margin-top: 0.2rem;
    margin-bottom: 0.35rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .ra__link {
    margin-top: 0.8rem;
  }

  /* the reviews */
  .rv__vf {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--color-line-strong);
  }
  .rv__vf img {
    height: auto;
  }
  .rv__vfh {
    font-size: 1rem;
    font-weight: 600;
  }
  .rv__grid {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    columns: 1;
    column-gap: 1.5rem;
  }
  @media (min-width: 44em) {
    .rv__grid {
      columns: 2;
    }
  }
  @media (min-width: 72em) {
    .rv__grid {
      columns: 3;
    }
  }
  .rv__card {
    break-inside: avoid;
    margin-bottom: 1.5rem;
    padding: 1.6rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-paper);
  }
  .rv__card figure {
    display: grid;
    gap: 1rem;
  }
  .rv__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .rv__tag {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold-ink);
  }
  .rv__tag + .rv__tag::before {
    content: '';
    display: inline-block;
    width: 1px;
    height: 0.7rem;
    margin-right: 0.75rem;
    vertical-align: -0.05rem;
    background: var(--color-line-strong);
  }
  .rv__quote {
    color: var(--color-ink);
    font-size: 0.9875rem;
    line-height: 1.65;
  }
  .rv__who {
    display: grid;
    gap: 0.05rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-line);
  }
  .rv__name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-navy);
  }
  .rv__share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line-strong);
  }
  .rv__share p {
    font-weight: 500;
    color: var(--color-ink);
  }
</style>
