---
/* MARKET INTELLIGENCE, "Six intelligence streams. One clear view of the market.": their figures under the title, the stream filters
   (buttons, in the page; ?stream=seis opens on one stream), the featured update with its numbered points and their signals, then
   every update as a ruled list. Each update opens on the live site until the update pages are built. */
import Layout from '../layouts/Layout.astro'
import PageHero from '../components/PageHero.astro'
import Closing from '../components/Closing.astro'
import { intro, filters, list, closing, updates } from '../data/pages/market-updates'

const lead = updates.find((u) => u.featured) ?? updates[0]
const others = updates.filter((u) => u !== lead)
const sig = (s: string) => (s.includes('IMPROVED') ? 'up' : s.includes('SOFTENING') ? 'down' : 'flat')
---

<Layout
  title="Market Updates | Alternative Investment Intelligence | AWM | Ascot Wealth Management"
  description={intro.lede}
  path="/market-updates"
>
  <PageHero crumbs={[{ label: 'Resources', href: '/resources' }, { label: 'Market Intelligence' }]} eyebrow={intro.eyebrow} title={intro.title} lede={intro.lede}>
    <dl class="mu-stats">
      {
        intro.stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd class="num">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </PageHero>

  <section class="section mu" aria-labelledby="mu-title">
    <div class="wrap">
      <div class="mu__head">
        <div class="head">
          <p class="eyebrow num"><span><span data-mu-count>{updates.length}</span> / Streams</span></p>
          <h2 id="mu-title" class="h2">{list.title}</h2>
          <p class="small mu__note">{list.note}</p>
        </div>
      </div>

      <div class="mu__filters" role="group" aria-label="Filter by stream" data-mu-filters>
        {
          filters.map((f, i) => (
            <button type="button" class="mu__chip" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
              {f.label}
            </button>
          ))
        }
      </div>

      <article class="mu__lead" data-streams={lead.streams.join(' ')}>
        <div class="mu__lead-main">
          <p class="mu__meta">
            <span class="mu__flag">{list.featured}</span>
            <span class="mu__tag">{lead.tag}</span>
            <time class="num">{lead.date}</time>
          </p>
          <h3 class="mu__lead-title">
            <a href={lead.href}>{lead.title}</a>
          </h3>
          <p>{lead.excerpt}</p>
          <p class="mu__foot">
            <a class="link-arrow" href={lead.href}>
              {list.cta}
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h9.5M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
            </a>
            <span class="small">{lead.read}</span>
          </p>
        </div>
        <ol class="mu__points" role="list">
          {
            lead.points.map((p, i) => (
              <li>
                <span class="num mu__pn">{String(i + 1).padStart(2, '0')}</span>
                <p>{p.text}</p>
                <span class={`mu__sig mu__sig--${sig(p.signal)}`}>{p.signal}</span>
              </li>
            ))
          }
        </ol>
      </article>

      <ol class="mu__list" role="list">
        {
          others.map((u) => (
            <li class="mu__item" data-streams={u.streams.join(' ')}>
              <p class="mu__meta">
                <span class="mu__tag">{u.tag}</span>
                <time class="num">{u.date}</time>
              </p>
              <h3 class="mu__title">
                <a href={u.href}>{u.title}</a>
              </h3>
              <p class="mu__excerpt">{u.excerpt}</p>
              <p class="mu__foot">
                <a class="link-arrow" href={u.href}>
                  {list.cta}
                  <span class="sr-only">: {u.title}</span>
                  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h9.5M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
                </a>
                <span class="small">{u.read}</span>
              </p>
            </li>
          ))
        }
      </ol>
      <div class="mu__more" data-mu-more data-off>
        <button type="button" class="btn btn-line" data-mu-more-btn>Show more updates</button>
        <p class="small num" data-mu-shown></p>
      </div>
    </div>
  </section>

  <Closing eyebrow="Market Intelligence" title={closing.title} text={closing.text} actions={[{ label: closing.cta, href: '/contact' }]} />
</Layout>

<script>
  const group = document.querySelector<HTMLElement>('[data-mu-filters]')
  if (group) {
    const chips = [...group.querySelectorAll<HTMLButtonElement>('[data-filter]')]
    const items = [...document.querySelectorAll<HTMLElement>('[data-streams]')]
    const count = document.querySelector<HTMLElement>('[data-mu-count]')
    const more = document.querySelector<HTMLElement>('[data-mu-more]')
    const moreBtn = document.querySelector<HTMLButtonElement>('[data-mu-more-btn]')
    const shownOut = document.querySelector<HTMLElement>('[data-mu-shown]')
    /* the list is long: 13 at a time (the featured update and twelve more), each stream filter starting again */
    const STEP = 13
    let key = 'all'
    let limit = STEP
    const render = () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === key)))
      const matched = items.filter((el) => key === 'all' || (el.dataset.streams ?? '').split(' ').includes(key))
      items.forEach((el) => el.toggleAttribute('data-off', !matched.slice(0, limit).includes(el)))
      if (count) count.textContent = String(matched.length)
      if (shownOut) shownOut.textContent = `${Math.min(limit, matched.length)} of ${matched.length}`
      more?.toggleAttribute('data-off', limit >= matched.length)
    }
    const apply = (k: string) => {
      key = k
      limit = STEP
      render()
    }
    moreBtn?.addEventListener('click', () => {
      const matched = items.filter((el) => el.hasAttribute('data-off') === false)
      limit += STEP
      render()
      const next = items.filter((el) => !el.hasAttribute('data-off'))[matched.length]
      next?.querySelector('a')?.focus()
    })
    const start = new URLSearchParams(location.search).get('stream')
    apply(start && chips.some((c) => c.dataset.filter === start) ? start : 'all')
    group.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]')
      if (!chip) return
      apply(chip.dataset.filter ?? 'all')
      const url = new URL(location.href)
      if (key === 'all') url.searchParams.delete('stream')
      else url.searchParams.set('stream', key)
      history.replaceState(null, '', url)
    })
  }
</script>

<style>
  .mu-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.75rem;
    margin-top: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .mu-stats dt {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .mu-stats dd {
    margin-top: 0.2rem;
    font-size: 1.5rem;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--color-navy);
  }
  .mu__note {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.71875rem;
    font-weight: 600;
  }
  .mu__filters {
    display: none;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  :global(html.js) .mu__filters {
    display: flex;
  }
  .mu__chip {
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius);
    background: var(--color-paper);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 550;
    color: var(--color-navy);
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease-soft),
      border-color 0.2s var(--ease-soft),
      color 0.2s var(--ease-soft);
  }
  .mu__chip:hover {
    border-color: var(--color-navy);
  }
  .mu__chip[aria-pressed='true'] {
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: #fff;
  }
  [data-off] {
    display: none !important;
  }

  .mu__lead {
    display: grid;
    gap: 2rem 4rem;
    margin-top: 2.5rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--color-mist);
    border-top: 2px solid var(--color-gold);
  }
  @media (min-width: 64em) {
    .mu__lead {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }
  .mu__lead-main {
    display: grid;
    align-content: start;
    gap: 1rem;
  }
  .mu__lead-title {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.1rem);
    font-weight: 330;
    line-height: 1.18;
    letter-spacing: -0.025em;
  }
  .mu__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    font-size: 0.75rem;
    color: var(--color-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .mu__tag,
  .mu__flag {
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--color-gold-ink);
  }
  .mu__flag {
    padding: 0 0.4rem;
    background: var(--color-gold);
    color: var(--color-navy);
    border-radius: var(--radius);
  }
  .mu__points {
    display: grid;
    align-content: start;
    border-top: 1px solid var(--color-line-strong);
  }
  .mu__points li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.35rem 0.5rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-line-strong);
  }
  .mu__points p {
    font-size: 0.9375rem;
    color: var(--color-ink);
  }
  .mu__pn {
    grid-row: span 2;
    padding-top: 0.15rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink-3);
  }
  .mu__sig {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--color-ink-3);
  }
  .mu__sig--up {
    color: var(--color-navy);
  }
  .mu__sig--down {
    color: var(--color-gold-ink);
  }

  .mu__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: 1rem;
  }
  @media (min-width: 56em) {
    .mu__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3.5rem;
    }
  }
  .mu__item {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.75rem 0 2rem;
    border-bottom: 1px solid var(--color-line);
  }
  .mu__title {
    font-size: clamp(1.15rem, 1.05rem + 0.3vw, 1.3rem);
    font-weight: 550;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }
  .mu__title a,
  .mu__lead-title a {
    text-decoration: none;
  }
  .mu__title a:hover,
  .mu__lead-title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .mu__excerpt {
    overflow-wrap: anywhere;
    font-size: 0.9375rem;
    line-height: 1.62;
  }
  .mu__more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2.5rem;
  }
  .mu__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: 0.25rem;
  }
</style>
