---
/* Every page: the head (title, description, canonical, sharing card, favicons, the firm as structured data), the bar, the page, the foot.
   While site.indexable is false every page also says noindex (as do nginx and robots.txt). */
import '@fontsource-variable/inter'
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { site } from '../data/site'

type Props = { title?: string; description?: string; path?: string; noindex?: boolean }
const { title = site.meta.title, description = site.meta.description, path = Astro.url.pathname, noindex = false } = Astro.props
const origin = (Astro.site?.origin ?? site.launchOrigin).replace(/\/$/, '')
const canonical = origin + (path === '/' ? '/' : path.replace(/\/$/, ''))
const robots = !site.indexable || noindex ? 'noindex, nofollow' : 'index, follow'

const org = {
  '@context': 'https://schema.org',
  '@type': 'FinancialService',
  name: site.name,
  legalName: site.legalName,
  url: site.launchOrigin,
  logo: `${origin}/icon-512.png`,
  image: `${origin}/og.jpg`,
  telephone: '+44 1344 851250',
  email: site.email,
  address: { '@type': 'PostalAddress', streetAddress: 'Scotch Corner, London Road', addressLocality: 'Sunningdale', addressRegion: 'Berkshire', postalCode: 'SL5 0ER', addressCountry: 'GB' },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: site.reviews.rating, reviewCount: site.reviews.countPlain, bestRating: '5' },
  sameAs: site.social.map((s) => s.href),
}
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${origin}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <slot name="after" />
    <script>
      import '../scripts/condense'
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.7rem 1rem;
    background: var(--color-navy);
    color: #fff;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: var(--radius);
    transform: translateY(-200%);
  }
  .skip:focus {
    transform: none;
  }
</style>
