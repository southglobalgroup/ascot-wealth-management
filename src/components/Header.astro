---
/* The bar: white, their logo, their three menus (Who We Are, Services, Resources) as full-width panels that open in one soft
   curtain, the phone number and "Book Consultation". Below 68em a Menu button opens the same menus as one sheet. */
import Logo from './Logo.astro'
import { menus } from '../data/nav'
import { site } from '../data/site'

const id = (label: string) => 'menu-' + label.toLowerCase().replace(/[^a-z]+/g, '-')
const path = Astro.url.pathname
const here = (href: string) => (href === '/' ? path === '/' || path.startsWith('/hero/') : path === href || path.startsWith(href + '/'))
---

<header class="bar" data-bar>
  <div class="wrap bar__in">
    <a href="/" class="bar__home" aria-label="Ascot Wealth Management, home">
      <Logo eager height={58} />
    </a>

    <nav class="bar__nav" aria-label="Main">
      <ul role="list">
        <li><a href="/" class="bar__link" aria-current={here('/') ? 'page' : undefined}>Home</a></li>
        {
          menus.map((m) => (
            <li>
              <button type="button" class="bar__link" aria-expanded="false" aria-controls={id(m.label)} data-menu-btn>
                {m.label}
                <svg class="caret" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
                  <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </button>
            </li>
          ))
        }
        <li><a href="/contact" class="bar__link" aria-current={here('/contact') ? 'page' : undefined}>Contact</a></li>
      </ul>
    </nav>

    <div class="bar__end">
      <a class="bar__phone num" href={site.phoneHref}>
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M4.2 1.8 6.3 4c.4.4.4 1 0 1.4l-1 1a8.6 8.6 0 0 0 4.3 4.3l1-1c.4-.4 1-.4 1.4 0l2.2 2.1c.4.4.4 1 0 1.4l-1.1 1.1c-.8.8-2 1-3 .5A14.4 14.4 0 0 1 1.7 6.4c-.5-1-.3-2.2.5-3l1.1-1.1c.4-.4 1-.4 1.4 0Z" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
        {site.phoneDisplay}
      </a>
      <div class="acct">
        <button type="button" class="acct__btn" aria-expanded="false" aria-controls="menu-login" aria-label="Login menu" data-menu-btn data-small>
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="6.5" r="3.25" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M3.5 17c.8-3.3 3.4-5 6.5-5s5.7 1.7 6.5 5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
        <div class="acct__menu" id="menu-login" data-menu>
          <ul role="list">
            {
              site.logins.map((l, i) => (
                <li style={`--i:${i}`}>
                  <a href={l.href}>
                    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
                      {l.icon === 'person' && (
                        <>
                          <circle cx="10" cy="6.5" r="3.25" fill="none" stroke="currentColor" stroke-width="1.5" />
                          <path d="M3.5 17c.8-3.3 3.4-5 6.5-5s5.7 1.7 6.5 5" fill="none" stroke="currentColor" stroke-width="1.5" />
                        </>
                      )}
                      {l.icon === 'briefcase' && (
                        <>
                          <rect x="2.75" y="6" width="14.5" height="10.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.5" />
                          <path d="M7 6V4.25h6V6" fill="none" stroke="currentColor" stroke-width="1.5" />
                        </>
                      )}
                      {l.icon === 'shield' && <path d="M10 2.5 16 5v4.5c0 3.7-2.6 6.6-6 8-3.4-1.4-6-4.3-6-8V5l6-2.5Z" fill="none" stroke="currentColor" stroke-width="1.5" />}
                    </svg>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <a class="btn btn-gold bar__cta" href="/contact">Book Consultation</a>
      <button type="button" class="bar__menu" aria-expanded="false" aria-controls="sheet" data-sheet-btn>
        <span class="bar__menu-label">Menu</span>
        <span class="bar__menu-icon" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  {
    menus.map((m) => (
      <div class="mega" id={id(m.label)} data-menu>
        <div class="wrap mega__in">
          <div class="mega__intro">
            <p class="eyebrow">{m.label}</p>
            <p class="mega__lead">{m.intro}</p>
            {m.all && (
              <a class="link-arrow" href={m.all.href}>
                {m.all.label}
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h9.5M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
              </a>
            )}
          </div>
          <ul class={`mega__grid${m.items.length === 4 ? ' mega__grid--2' : ''}`} role="list">
            {m.items.map((it, i) => (
              <li style={`--i:${i}`}>
                <a class="mega__item" href={it.href}>
                  <span class="mega__label">{it.label}</span>
                  <span class="mega__text">{it.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))
  }

  <div class="sheet" id="sheet" data-sheet>
    <div class="wrap sheet__in">
      <a href="/" class="sheet__top">Home</a>
      {
        menus.map((m) => (
          <div class="sheet__group">
            <button type="button" class="sheet__head" aria-expanded="false" data-acc>
              {m.label}
              <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
            </button>
            <div class="sheet__body">
              <ul role="list">
                {m.items.map((it) => (
                  <li><a href={it.href}>{it.label}</a></li>
                ))}
                {m.all && <li><a href={m.all.href} class="sheet__all">{m.all.label}</a></li>}
              </ul>
            </div>
          </div>
        ))
      }
      <a href="/contact" class="sheet__top">Contact</a>
      <div class="sheet__foot">
        <a class="btn btn-gold" href="/contact">Book Consultation</a>
        <a class="sheet__phone num" href={site.phoneHref}>{site.phoneDisplay}</a>
        <a class="sheet__mail" href={`mailto:${site.email}`}>{site.email}</a>
        <ul class="sheet__logins" role="list">
          {site.logins.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
    </div>
  </div>
  <div class="bar__scrim" data-scrim aria-hidden="true"></div>
</header>

<script>
  import '../scripts/nav'
</script>

<style>
  .bar {
    view-transition-name: bar;
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
  }
  /* the bar is --bar-h tall INCLUDING its 1px rule, so every hero below it is exactly the rest of the screen */
  .bar__in {
    height: calc(var(--bar-h) - 1px);
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .bar__home {
    flex: none;
    display: flex;
  }
  .bar__home :global(.logo) {
    height: 58px;
    width: auto;
  }
  @media (max-width: 40em) {
    .bar__home :global(.logo) {
      height: 48px;
    }
  }
  .bar__nav {
    display: none;
    margin-left: auto;
  }
  .bar__nav ul {
    display: flex;
    gap: 0.25rem;
  }
  .bar__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: calc(var(--bar-h) - 1px);
    padding-inline: 0.85rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
    background: none;
    border: 0;
    cursor: pointer;
    position: relative;
    text-decoration: none;
  }
  .bar__link::after {
    content: '';
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: -1px;
    height: 2px;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-soft);
  }
  .bar__link:hover::after,
  .bar__link[aria-expanded='true']::after,
  .bar__link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .caret {
    color: var(--color-ink-3);
    transition: transform 0.35s var(--ease-soft);
  }
  .bar__link[aria-expanded='true'] .caret {
    transform: rotate(180deg);
  }
  .bar__end {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-left: auto;
  }
  .bar__phone {
    display: none;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-navy);
    text-decoration: none;
  }
  .bar__phone svg {
    color: var(--color-gold-ink);
  }
  .bar__cta {
    display: none;
  }
  .bar__menu {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding-inline: 0.9rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius);
    background: none;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-navy);
    cursor: pointer;
  }
  .bar__menu-icon {
    display: grid;
    gap: 5px;
    width: 18px;
  }
  .bar__menu-icon i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.4s var(--ease-soft);
  }
  .bar__menu[aria-expanded='true'] .bar__menu-icon i:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .bar__menu[aria-expanded='true'] .bar__menu-icon i:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }
  @media (min-width: 40em) {
    .bar__cta {
      display: inline-flex;
    }
  }

  /* --- the account menu (as on the live site): a small panel under the person icon, same soft curtain as the big menus --- */
  .acct {
    position: relative;
    display: none;
  }
  @media (min-width: 68em) {
    .acct {
      display: block;
    }
  }
  .acct__btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: none;
    color: var(--color-navy);
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease-soft),
      border-color 0.2s var(--ease-soft);
  }
  .acct__btn:hover,
  .acct__btn[aria-expanded='true'] {
    background: var(--color-mist);
    border-color: var(--color-line);
  }
  .acct__menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    min-width: 13rem;
    padding: 0.4rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: 0 18px 40px -24px rgb(1 24 59 / 0.35);
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path 0.45s var(--ease-soft),
      visibility 0s linear 0.45s;
  }
  .acct__menu:global(.is-open) {
    clip-path: inset(0 -40px -60px -40px);
    visibility: visible;
    transition: clip-path 0.45s var(--ease-soft);
  }
  /* a bridge over the gap under the icon, so the pointer can travel down to the panel without it closing */
  .acct__menu::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -0.75rem;
    height: 0.75rem;
  }
  .acct__menu li {
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.25s var(--ease-soft),
      transform 0.4s var(--ease-soft);
  }
  .acct__menu:global(.is-open) li {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.05s + var(--i) * 0.035s);
  }
  .acct__menu a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    transition: background-color 0.2s var(--ease-soft);
  }
  .acct__menu a:hover {
    background: var(--color-mist);
  }
  .acct__menu svg {
    color: var(--color-gold-ink);
  }
  .sheet__logins {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.9375rem;
  }
  .sheet__logins a {
    color: var(--color-navy);
    font-weight: 500;
  }
  @media (min-width: 68em) {
    .bar__nav {
      display: block;
    }
    .bar__end {
      margin-left: 0;
    }
    .bar__menu {
      display: none;
    }
  }
  @media (min-width: 82em) {
    .bar__phone {
      display: inline-flex;
    }
  }

  /* --- the menus: one soft curtain down from the bar, its items following a beat behind ---------------------------- */
  /* below the desktop bar the sheet holds the menus: these are out of the layout entirely (hidden ones still widened the page) */
  @media (max-width: 67.99em) {
    .mega {
      display: none;
    }
  }
  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path 0.5s var(--ease-soft),
      visibility 0s linear 0.5s;
  }
  .mega.is-open {
    clip-path: inset(0 0 -1px 0);
    visibility: visible;
    transition: clip-path 0.5s var(--ease-soft);
  }
  .mega__in {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 2.6fr);
    gap: 3rem;
    padding-block: 2.5rem 2.75rem;
  }
  .mega__intro {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding-right: 2rem;
    border-right: 1px solid var(--color-line);
  }
  .mega__lead {
    font-size: 1.25rem;
    font-weight: 330;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--color-navy);
  }
  .mega__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.25rem 1.5rem;
  }
  .mega__grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .mega__grid li {
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.3s var(--ease-soft),
      transform 0.45s var(--ease-soft);
  }
  .mega.is-open .mega__grid li {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.06s + var(--i) * 0.035s);
  }
  .mega__item {
    display: grid;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    margin-inline: -1rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background-color 0.2s var(--ease-soft);
  }
  .mega__item:hover {
    background: var(--color-mist);
  }
  .mega__label {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-navy);
  }
  .mega__text {
    font-size: 0.84375rem;
    line-height: 1.5;
    color: var(--color-ink-3);
  }
  .bar__scrim {
    position: fixed;
    inset: var(--bar-h) 0 0 0;
    z-index: -1;
    background: rgb(1 24 59 / 0.22);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s var(--ease-soft);
  }
  /* the shade is only a picture: it must not catch the pointer, or moving onto the page would still count as "in the bar" and the
     menu would stay open (his note, 2026-11-19). A click on the page still closes it (nav.ts, document click). */
  .bar[data-open] .bar__scrim {
    opacity: 1;
  }

  /* --- the phone sheet -------------------------------------------------------------------------------------------- */
  .sheet {
    position: fixed;
    inset: var(--bar-h) 0 0 0;
    background: var(--color-paper);
    overflow-y: auto;
    overscroll-behavior: contain;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path 0.55s var(--ease-soft),
      visibility 0s linear 0.55s;
  }
  .sheet.is-open {
    clip-path: inset(0);
    visibility: visible;
    transition: clip-path 0.55s var(--ease-soft);
  }
  .sheet__in {
    display: grid;
    padding-block: 1rem 2.5rem;
  }
  .sheet__top,
  .sheet__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 3.5rem;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    background: none;
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-navy);
    text-decoration: none;
    text-align: left;
    cursor: pointer;
  }
  .sheet__head svg {
    color: var(--color-ink-3);
    transition: transform 0.4s var(--ease-soft);
  }
  .sheet__head[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .sheet__body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s var(--ease-soft);
  }
  .sheet__head[aria-expanded='true'] + .sheet__body {
    grid-template-rows: 1fr;
  }
  .sheet__body ul {
    overflow: hidden;
    display: grid;
  }
  .sheet__body a {
    display: flex;
    align-items: center;
    min-height: 2.9rem;
    padding-left: 1rem;
    color: var(--color-ink-2);
    text-decoration: none;
    font-size: 1rem;
  }
  .sheet__body li:last-child a {
    margin-bottom: 0.75rem;
  }
  .sheet__all {
    font-weight: 600;
    color: var(--color-navy) !important;
  }
  .sheet__foot {
    display: grid;
    gap: 1rem;
    padding-top: 2rem;
  }
  .sheet__phone {
    font-size: 1.5rem;
    font-weight: 330;
    color: var(--color-navy);
    text-decoration: none;
  }
  .sheet__mail {
    color: var(--color-ink-2);
  }
  @media (min-width: 68em) {
    .sheet {
      display: none;
    }
  }
</style>
