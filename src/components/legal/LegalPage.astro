---
/* The legal and regulatory pages (privacy, cookies, terms, client documents, regulatory information): the page hero, then their text
   in full as .prose, with an on-page contents list built from the H2s beside it on a wide screen (above it on a phone). Email
   addresses, telephone numbers and web addresses in the text become links; the words are not changed. */
import Layout from '../../layouts/Layout.astro'
import PageHero from '../PageHero.astro'
import Closing from '../Closing.astro'
import { contact } from '../../data/home'
import { site } from '../../data/site'
import type { Block } from '../../data/pages/legal'

type Props = { title: string; description: string; path: string; heading: string; updated?: string; intro?: string[]; blocks?: Block[] }
const { title, description, path, heading, updated = '', intro = [], blocks = [] } = Astro.props

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
const linkify = (s: string) =>
  esc(s).replace(/([\w.+-]+@[\w-]+(?:\.[\w-]+)+)|((?:www|register)\.[\w-]+(?:\.[\w-]+)+)|(01344 851250)/g, (_m, email, web, tel) =>
    email ? `<a href="mailto:${email}">${email}</a>` : web ? `<a href="https://${web}" rel="noopener">${web}</a>` : `<a href="${site.phoneHref}">${tel}</a>`,
  )
const toc = blocks.filter((b): b is Extract<Block, { t: 'h2' }> => b.t === 'h2')
/* the privacy policy dates itself at its end; the others under the title */
const last = blocks[blocks.length - 1]
const updatedTop = updated && !(last && last.t === 'p' && last.text === updated)
---

<Layout title={title} description={description} path={path}>
  <PageHero crumbs={[{ label: heading }]} eyebrow={site.legalName} title={heading} lede={intro[0]}>
    {updatedTop && <p class="small lg__updated">{updated}</p>}
  </PageHero>

  <section class="section lg">
    <div class:list={['wrap', 'lg__in', { 'lg__in--toc': toc.length >= 3 }]}>
      {
        toc.length >= 3 && (
          <nav class="lg__toc" aria-labelledby="lg-toc-title">
            <p id="lg-toc-title" class="lg__toc-h">
              Page overview
            </p>
            <ol role="list">
              {toc.map((h, i) => (
                <li>
                  <a href={`#${h.id}`}>
                    <span class="num">{i + 1}.</span>
                    <span>{h.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="prose lg__prose">
        {intro.slice(1).map((p) => <p set:html={linkify(p)} />)}
        {
          blocks.map((b) =>
            b.t === 'h2' ? (
              <h2 id={b.id}>{b.text}</h2>
            ) : b.t === 'h3' ? (
              <h3>{b.text}</h3>
            ) : b.t === 'ul' ? (
              <ul>
                {b.items.map((it) => (
                  <li set:html={linkify(it)} />
                ))}
              </ul>
            ) : b.t === 'lines' ? (
              <p class="lg__lines" set:html={b.lines.map(linkify).join('<br />')} />
            ) : b.t === 'quote' ? (
              <p class="lg__quote" set:html={linkify(b.text)} />
            ) : (
              <p set:html={linkify(b.text)} />
            ),
          )
        }
        <slot />
      </div>
    </div>
  </section>

  <Closing eyebrow={contact.eyebrow} title={contact.title} text={contact.lede} actions={[{ label: contact.cta, href: '/contact' }]} />
</Layout>

<style>
  .lg__updated {
    letter-spacing: 0.04em;
  }
  .lg__in {
    display: grid;
    gap: 2.5rem;
  }
  .lg__prose > :first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .lg__toc {
    align-self: start;
    padding: 1.25rem 1.25rem 1.1rem;
    border: 1px solid var(--color-line);
    max-width: 46rem;
  }
  .lg__toc-h {
    font-size: 0.71875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-ink);
  }
  .lg__toc ol {
    display: grid;
    margin-top: 0.75rem;
  }
  .lg__toc a {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.25rem;
    padding-block: 0.4rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-ink-2);
    text-decoration: none;
  }
  .lg__toc a:hover {
    color: var(--color-navy);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .lg__toc .num {
    color: var(--color-ink-3);
  }
  .lg__lines {
    color: var(--color-ink);
  }
  .lg__quote {
    padding: 0.25rem 0 0.25rem 1.1rem;
    border-left: 2px solid var(--color-gold);
    font-size: 1.0625rem;
    color: var(--color-ink);
  }
  .prose :global(a) {
    overflow-wrap: anywhere;
  }
  @media (min-width: 64em) {
    .lg__in--toc {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 5rem;
    }
    .lg__toc {
      position: sticky;
      top: calc(var(--bar-h) + 1.5rem);
      padding: 0;
      border: 0;
      border-top: 1px solid var(--color-line);
      padding-top: 1.1rem;
    }
  }
</style>
