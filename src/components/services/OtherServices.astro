---
/* "Explore Our Other Services": the five other services as small scenes, numbered as on the home page's index (01 Investments ...
   06 Business), each with its own line from the live site's menu, then "View All Services". The live page offers only the services
   either side; all five are here so none is two clicks away. On a phone they are rows: a small picture, then the words. */
import { Image } from 'astro:assets'
import { services, serviceLabels as L } from '../../data/pages/services'
import { services as navServices } from '../../data/nav'

type Props = { current: string }
const { current } = Astro.props
const others = services.map((s, i) => ({ s, n: String(i + 1).padStart(2, '0'), text: navServices.find((x) => x.href === `/services/${s.slug}`)?.text })).filter((x) => x.s.slug !== current)
---

<section class="section bg-tint os" aria-labelledby="os-title">
  <div class="wrap">
    <div class="os__head">
      <h2 id="os-title" class="h2">{L.others}</h2>
      <a class="btn btn-line" href="/services">{L.all}</a>
    </div>
    <ul class="os__list" role="list">
      {
        others.map(({ s, n, text }) => (
          <li>
            <a class="os__card" href={`/services/${s.slug}`}>
              <span class="os__media">
                <Image src={s.img} alt="" widths={[240, 480]} sizes="(min-width: 64em) 220px, (min-width: 40em) 30vw, 96px" class="fill-img" />
              </span>
              <span class="os__words">
                <span class="os__n num">{n}</span>
                <span class="os__name">{s.title}</span>
                {text && <span class="os__text">{text}</span>}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .os__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
  }
  .os__list {
    display: grid;
    margin-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-line-strong);
  }
  .os__card {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1.1rem;
    align-items: start;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
  }
  .os__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-mist-2);
  }
  .os__words {
    display: grid;
    gap: 0.3rem;
  }
  .os__n {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-gold-ink);
  }
  .os__name {
    font-size: 1.0625rem;
    font-weight: 550;
    line-height: 1.3;
    color: var(--color-navy);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    transition: text-decoration-color 0.2s var(--ease-soft);
  }
  .os__card:hover .os__name {
    text-decoration-color: currentColor;
  }
  .os__text {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-ink-3);
  }
  @media (min-width: 40em) {
    .os__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0 1.5rem;
      border-top: 0;
    }
    .os__card {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
      padding-block: 0 1.75rem;
      border-bottom: 0;
    }
    .os__words {
      padding-top: 0.9rem;
      border-top: 1px solid var(--color-line-strong);
    }
  }
  @media (min-width: 64em) {
    .os__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
