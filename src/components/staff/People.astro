---
/* MEET THE TEAM: everyone on their team page, in its order, as a portrait grid. Under each portrait the name and role, then what
   the live card shows on hover, here always shown: their line, the VouchedFor rating where they have one, and their areas of focus.
   Each person has an address of their own (/staff#mark-insley), which the testimonials page links to. */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { people, staffPage } from '../../data/pages/staff'

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/img/staff/*.webp', { eager: true })
const photo = (id: string) => files[`../../assets/img/staff/${id}.webp`]?.default
const t = staffPage.team
---

<section class="section pp" aria-labelledby="team-title">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="team-title" class="h2">{t.title}</h2>
    </div>
    <ul class="pp__grid" role="list">
      {
        people.map((p, i) => {
          const img = photo(p.id)
          return (
            <li id={p.id} class="pp__card">
              <div class="pp__photo">
                {img && <Image src={img} alt={p.name} widths={[300, 450, 600]} sizes="(min-width: 64em) 270px, (min-width: 40em) 30vw, 45vw" loading={i < 4 ? 'eager' : 'lazy'} class="fill-img" />}
              </div>
              <h3 class="pp__name">{p.name}</h3>
              <p class="pp__role">{p.role}</p>
              {p.quote && <p class="pp__quote">“{p.quote}”</p>}
              {p.rating && (
                <p class="pp__vf">
                  <span class="pp__vfk">VouchedFor</span>
                  <span class="pp__star" aria-hidden="true">★</span>
                  <span class="num pp__score">{p.rating}</span>
                  <span class="num">{p.reviews}</span>
                </p>
              )}
              {p.focus && (
                <ul class="pp__focus" role="list">
                  {p.focus.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              )}
            </li>
          )
        })
      }
    </ul>
  </div>
</section>

<style>
  .pp__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  @media (min-width: 40em) {
    .pp__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem 1.5rem;
    }
  }
  @media (min-width: 64em) {
    .pp__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 3.25rem 2rem;
    }
  }
  .pp__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .pp__photo {
    position: relative;
    aspect-ratio: 5 / 6;
    overflow: hidden;
    margin-bottom: 1rem;
    background: var(--color-mist-2);
  }
  .pp__card:target .pp__photo {
    outline: 2px solid var(--color-gold);
    outline-offset: 4px;
  }
  .pp__name {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .pp__role {
    margin-top: 0.3rem;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .pp__quote {
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-2);
    overflow-wrap: anywhere;
  }
  .pp__vf {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.45rem;
    margin-top: 0.7rem;
    font-size: 0.8125rem;
    color: var(--color-ink-3);
  }
  .pp__vfk {
    font-weight: 600;
    color: var(--color-navy);
  }
  .pp__star {
    color: var(--color-gold);
  }
  .pp__score {
    font-weight: 600;
    color: var(--color-ink);
  }
  .pp__focus {
    display: grid;
    gap: 0.3rem;
    margin-top: 0.8rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-ink-3);
    overflow-wrap: anywhere;
  }
  .pp__focus li {
    position: relative;
    padding-left: 0.95rem;
  }
  .pp__focus li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 0.5rem;
    height: 1px;
    background: var(--color-gold-ink);
  }
</style>
