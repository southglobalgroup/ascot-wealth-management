---
/* The hero's two actions, the same on all four options: their "Book a free introductory call" and the services. */
import { book } from '../../data/site'
type Props = { tone?: 'light' | 'dark' }
const { tone = 'light' } = Astro.props
---

<div class="ctas">
  <a class="btn btn-gold" href={book.href}>
    {book.label}
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h9.5M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
  </a>
  <a class={`btn ${tone === 'dark' ? 'btn-glass' : 'btn-line'}`} href="/services">Explore our services</a>
</div>

<style>
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
