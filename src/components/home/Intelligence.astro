---
/* MARKET INTELLIGENCE: the three latest of their weekly updates, each with its sector and date. */
import { Image } from 'astro:assets'
import { intelligence as m } from '../../data/home'
---

<section class="section bg-tint mi" aria-labelledby="mi-title">
  <div class="wrap">
    <div class="mi__head">
      <div class="head">
        <p class="eyebrow">{m.eyebrow}</p>
        <h2 id="mi-title" class="h2">{m.title}</h2>
      </div>
      <a class="link-arrow" href={m.link.href}>
        {m.link.label}
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h9.5M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
      </a>
    </div>
    <ul class="mi__grid" role="list">
      {
        m.articles.map((a) => (
          <li>
            <a class="mi__card" href={a.href}>
              <div class="mi__img">
                <Image src={a.img} alt="" widths={[400, 720]} sizes="(min-width: 64em) 380px, 100vw" class="fill-img" />
              </div>
              <div class="mi__body">
                <p class="mi__meta">
                  <span class="mi__tag">{a.tag}</span>
                  <time class="num">{a.date}</time>
                </p>
                <h3 class="h3 mi__title">{a.title}</h3>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .mi__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
  }
  .mi__grid {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  @media (min-width: 56em) {
    .mi__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .mi__card {
    display: grid;
    height: 100%;
    grid-template-rows: auto 1fr;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    text-decoration: none;
    transition: border-color 0.25s var(--ease-soft);
  }
  .mi__card:hover {
    border-color: var(--color-line-strong);
  }
  .mi__card:hover .mi__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .mi__img {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-mist-2);
  }
  .mi__body {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.4rem 1.5rem 1.75rem;
  }
  .mi__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.75rem;
    color: var(--color-ink-3);
  }
  .mi__tag {
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-ink);
  }
</style>
