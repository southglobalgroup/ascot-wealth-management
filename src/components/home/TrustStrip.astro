---
/* Under heroes A and D (B and C carry these facts in the hero itself): the regulator, the reviews and the telephone, each with
   its source. The FCA and VouchedFor marks are their own files, in full colour. */
import { Image } from 'astro:assets'
import fca from '../../assets/brand/fca-logo.svg'
import vouched from '../../assets/brand/vouchedfor-logo.svg'
import { site } from '../../data/site'
import { trust } from '../../data/home'
---

<section class="ts" aria-label="Regulation and reviews">
  <div class="wrap ts__in">
    <a class="ts__cell" href={site.fca.register} rel="noopener" target="_blank">
      <Image src={fca} alt="Financial Conduct Authority" width={112} height={Math.round((112 * fca.height) / fca.width)} />
      <span class="ts__text">
        <span class="ts__k">{trust.fcaTitle}</span>
        <span class="small">{site.fca.line}</span>
      </span>
    </a>
    <a class="ts__cell" href={trust.reviewsLink.href}>
      <Image src={vouched} alt="VouchedFor" width={156} height={Math.round((156 * vouched.height) / vouched.width)} />
      <span class="ts__text">
        <span class="ts__k num">
          {site.reviews.rating}
          <span class="ts__stars" aria-hidden="true">
            {Array.from({ length: 5 }, () => <svg viewBox="0 0 20 20" width="13" height="13"><path d="m10 1.8 2.5 5.3 5.8.7-4.3 4 1.1 5.7L10 14.7l-5.1 2.8L6 11.8 1.7 7.8l5.8-.7L10 1.8Z" fill="currentColor" /></svg>)}
          </span>
        </span>
        <span class="small num">{site.reviews.count} reviews. {site.reviews.line}</span>
      </span>
    </a>
    <a class="ts__cell ts__cell--call" href={site.phoneHref}>
      <span class="ts__text">
        <span class="ts__label">Telephone</span>
        <span class="ts__phone num">{site.phoneDisplay}</span>
      </span>
    </a>
  </div>
</section>

<style>
  .ts {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
  }
  .ts__in {
    display: grid;
  }
  @media (min-width: 64em) {
    .ts__in {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 0.7fr);
    }
  }
  .ts__cell {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 1.6rem;
    text-decoration: none;
  }
  .ts__cell img {
    flex: none;
    height: auto;
  }
  .ts__cell + .ts__cell {
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 64em) {
    .ts__cell + .ts__cell {
      border-top: 0;
      border-left: 1px solid var(--color-line);
      padding-left: 2rem;
    }
    .ts__cell:not(:last-child) {
      padding-right: 2rem;
    }
  }
  .ts__text {
    display: grid;
    gap: 0.2rem;
  }
  .ts__k {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    color: var(--color-navy);
  }
  .ts__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--color-gold);
  }
  .ts__label {
    font-size: 0.71875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-ink);
  }
  .ts__phone {
    font-size: 1.5rem;
    font-weight: 330;
    letter-spacing: -0.01em;
    color: var(--color-navy);
  }
</style>
